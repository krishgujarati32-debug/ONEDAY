{
  "name": "ai-systems-engineer-roadmap",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:curriculum": "tsx scripts/validate-curriculum.ts",
    "curriculum:index": "tsx scripts/build-manifest.ts",
    "test:routes": "tsx scripts/smoke-routes.ts",
    "format": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,css,json}\" \"scripts/*.ts\" \"tests/*.ts\" \"*.{json,ts,mjs,md}\" \"docs/*.md\"",
    "check:resource-links": "tsx scripts/check-resource-links.ts",
    "check:resource-internal-links": "tsx scripts/check-resource-internal-links.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
